---
/**
 * Startseite (Säule, RECETTE §5), eigene Trame: Stand und Rechtsgrundlage, sofort das Rentenfenster
 * (ohne Scrollen sichtbar), der zitierbare Absatz (eingeklappt), eine Zeitleiste aller Jahrgänge
 * 1958 bis 1970, die Gegenüberstellung geltendes Recht / Kommissionsvorschlag, vier Folgerechnungen
 * als Karten mit einem gerechneten Beispiel, dann der Text mit Mini-Rechnern und die FAQ.
 */
import PageLayout from '../layouts/PageLayout.astro';
import FensterRechner from './calc/FensterRechner';
import MiniSim from './calc/MiniSim';
import Clamp from './Clamp.astro';
import { HOME } from '../content/home';
import { route, ROUTES, type Locale } from '../i18n/routes';
import { label } from '../i18n/nav';
import { helpers } from '../lib/helpers';
import { P, type SourceKey } from '../lib/engine/params';
import { regelalter, besondersAlter, fmtAlter } from '../lib/engine/alter';
import { nettoStandard } from '../lib/engine/geld';
import { witwenrente } from '../lib/engine/hinterbliebene';
import { formatMoney, displayDate } from '../lib/format';
import { faqSchema, organizationSchema, websiteSchema, webPageSchema, webApplicationSchema } from '../lib/seo';
import { LAST_UPDATED, LANG_TAGS } from '../data/site-config';
import { dativ } from '../lib/dativ';
interface Props { lang: Locale }
const { lang } = Astro.props;
const de = lang === 'de';
const x = HOME[lang];
const h = helpers(lang);
const path = route('home', lang);
const D = (t: string) => (de ? dativ(t) : t);
const parts = D(x.body(h)).split(/<!--mini:([A-Za-z0-9_]+)-->/);
const faqs = x.faqs(h).map((f) => ({ q: D(f.q), a: D(f.a) }));
const keys: SourceKey[] = ['sgb6_35', 'sgb6_235', 'sgb6_236', 'sgb6_236a', 'sgb6_236b', 'sgb6_77', 'sgb6_99', 'estg_22', 'drvWerte', 'bregReform', 'drvReform'];
const sources = keys.map((k) => ({ name: P.sources[k].label[lang], url: P.sources[k].url }));
const jsonLd = [websiteSchema(lang), organizationSchema(lang), webPageSchema({ name: x.h1, description: x.description, path, lang }), webApplicationSchema({ name: x.h1, description: x.description, path, lang }), faqSchema(faqs, lang)];
const $ = (n: number) => formatMoney(n, 0, lang);
const has = (id: string) => ROUTES.some((r) => r.id === id);
const r = (id: string) => (has(id) ? route(id, lang) : undefined);
// Zeitleiste: Alter 60 bis 68 auf der Achse, je Jahrgang 63 (früh), 45-Jahre-Grenze, Regelaltersgrenze.
const A0 = 60, A1 = 68;
const pos = (a: { j: number; m: number }) => ((a.j + a.m / 12 - A0) / (A1 - A0)) * 100;
const jahre = Array.from({ length: 13 }, (_, i) => 1958 + i);
const zeile = (j: number) => ({ j, regel: regelalter(j), b45: besondersAlter(j), seite: has(`jahrgang-${j}`) ? route(`jahrgang-${j}`, lang) : undefined });
const nb = nettoStandard(1600);
const wb = witwenrente({ renteVerstorbener: 1600, gross: true, altesRecht: false, einkommen: [{ typ: 'rente_ab_2011', brutto: 1200 }], kinder: 0, rw: P.rentenwert.ab_2026_07 });
const karten = [
  { id: 'rentenrechner-brutto-netto', t: de ? 'Netto' : 'Net', d: de ? `Von 1.600 € brutto bleiben ${$(nb.netto)}.` : `€1,600 gross leaves ${$(nb.netto)}.` },
  { id: 'rente-steuer-rechner', t: de ? 'Steuer' : 'Tax', d: de ? `Rentenbeginn 2026: ${P.steuer.besteuerungsanteil['2026']} % steuerpflichtig.` : `Starting in 2026: ${P.steuer.besteuerungsanteil['2026']}% is taxable.` },
  { id: 'witwenrente-rechner', t: de ? 'Witwenrente' : 'Widow’s pension', d: de ? `Aus 1.600 € Rente, mit 1.200 € eigener Rente: ${$(wb.zahlbetrag)}.` : `From a €1,600 pension, with €1,200 of your own: ${$(wb.zahlbetrag)}.` },
  { id: 'erwerbsminderungsrente', t: de ? 'Erwerbsminderung' : 'Disability', d: de ? 'Zurechnungszeit bis 66 Jahre und 3 Monate.' : 'Added period up to 66 years and 3 months.' },
];
---
<PageLayout title={x.title} description={x.description} lang={lang} jsonLd={jsonLd} faqs={faqs} sources={sources}>
  <header class="mb-4">
    <p class="text-sm font-semibold uppercase tracking-wide text-accent-800">{de ? 'SGB VI · Rentenwert 42,52 € ab 1. Juli 2026 · alle Jahrgänge' : 'SGB VI · pension value €42.52 from 1 July 2026 · every birth year'}</p>
    <h1 class="mt-1 text-3xl font-bold text-navy-900 md:text-[2.5rem] md:leading-tight">{x.h1}</h1>
    <p class="mt-2 text-lg text-navy-700">{x.intro}</p>
    <p class="mt-2 text-sm text-navy-700">
      {de ? 'Rentenwert und Tarif 2026, Gesetzesstand Oktober 2026' : '2026 pension value and tax schedule, law as of October 2026'} · <a class="underline" href={route('method', lang)}>{label('method', lang)}</a> · <a class="underline" href={route('about', lang)}>{label('about', lang)}</a>
    </p>
  </header>
  <section id="rechner" data-outil aria-label={de ? 'Rentenfenster' : 'Retirement window'}>
    <FensterRechner client:load lang={lang} methodHref={route('method', lang)} />
  </section>
  <section class="mt-8" aria-labelledby="kurz">
    <h2 id="kurz" class="sr-only">{de ? 'Kurz gesagt' : 'In short'}</h2>
    <Clamp text={D(x.resume(h))} lang={lang} id="clamp-home" sentences={2} />
  </section>
  <section class="mt-10 border-t border-navy-200 pt-6" aria-labelledby="zeit" data-chrome>
    <h2 id="zeit" class="text-2xl font-bold text-navy-900">{de ? 'Das Rentenfenster jedes Jahrgangs' : 'The retirement window of each birth year'}</h2>
    <p class="mt-2 text-navy-700">{de ? 'Heller Balken: ab 63 mit Abschlag (35 Jahre). Strich: ohne Abschlag nach 45 Jahren. Dunkel: Regelaltersgrenze.' : 'Light bar: from 63 with a reduction (35 years). Tick: no reduction after 45 years. Dark: standard retirement age.'}</p>
    <ul class="mt-4 space-y-1.5">
      {jahre.map((j) => { const z = zeile(j); return (
        <li class="grid grid-cols-[3.5rem_1fr_7.5rem] items-center gap-3 text-sm">
          {z.seite ? <a class="font-semibold text-navy-900 underline" href={z.seite}>{j}</a> : <span class="font-semibold text-navy-900">{j}</span>}
          <span class="zeit-bar relative block h-3 rounded">
            <span class="zeit-frueh absolute inset-y-0 rounded-l" style={`left:${pos({ j: 63, m: 0 })}%;width:${pos(z.regel) - pos({ j: 63, m: 0 })}%`}></span>
            <span class="absolute -inset-y-0.5 w-0.5 bg-navy-900" style={`left:${pos(z.b45)}%`}></span>
            <span class="zeit-voll absolute inset-y-0 rounded-r" style={`left:${pos(z.regel)}%;right:0`}></span>
          </span>
          <span class="tabular-nums text-right text-navy-800">{fmtAlter(z.regel, lang)}</span>
        </li>); })}
    </ul>
    <p class="mt-2 flex justify-between pl-[4.25rem] pr-[8.25rem] text-xs text-navy-600" aria-hidden="true"><span>60</span><span>63</span><span>65</span><span>68</span></p>
  </section>
  <section class="mt-10 border-t border-navy-200 pt-6" aria-labelledby="recht" data-chrome>
    <h2 id="recht" class="text-2xl font-bold text-navy-900">{de ? 'Geltendes Recht und Vorschlag der Kommission' : 'Current law and the commission proposal'}</h2>
    <div class="mt-4 grid gap-4 md:grid-cols-2">
      <div class="rounded-lg border border-navy-300 bg-white p-4">
        <p class="font-semibold text-navy-900">{de ? 'Gilt heute (SGB VI)' : 'Applies today (SGB VI)'}</p>
        <ul class="mt-2 list-disc space-y-1 pl-5 text-sm text-navy-800">
          <li>{de ? 'Nach 45 Jahren ohne Abschlag, ab Jahrgang 1964 mit 65' : 'No reduction after 45 years, at 65 from the 1964 cohort'}</li>
          <li>{de ? 'Nach 35 Jahren ab 63, 0,3 % Abschlag je Monat' : 'After 35 years from 63, minus 0.3% a month'}</li>
          <li>{de ? 'Regelaltersgrenze 67 ab Jahrgang 1964' : 'Standard age 67 from the 1964 cohort'}</li>
        </ul>
      </div>
      <div class="rounded-lg border border-amber-300 bg-amber-50 p-4">
        <p class="font-semibold text-navy-900">{de ? 'Vorgeschlagen am 23. Juni 2026, kein Gesetz' : 'Proposed on 23 June 2026, not law'}</p>
        <ul class="mt-2 list-disc space-y-1 pl-5 text-sm text-navy-800">
          <li>{de ? 'Rente nach 45 Jahren ohne Abschlag abschaffen' : 'Abolish the unreduced pension after 45 years'}</li>
          <li>{de ? 'Frühestens 64 statt 63, danach mit der Regelaltersgrenze' : 'Earliest 64 instead of 63, then moving with the standard age'}</li>
          <li>{de ? 'Ab 2031 an die Lebenserwartung koppeln, bis 2041 etwa 67,5' : 'Linked to life expectancy from 2031, about 67.5 by 2041'}</li>
        </ul>
        {r('rentenreform') && <a class="mt-2 inline-block text-sm font-medium text-accent-800 underline" href={r('rentenreform')}>{de ? 'Stand der Reform' : 'Where the reform stands'}</a>}
      </div>
    </div>
  </section>
  <section class="mt-10 border-t border-navy-200 pt-6" aria-labelledby="danach" data-chrome>
    <h2 id="danach" class="text-2xl font-bold text-navy-900">{de ? 'Nach dem Datum: vier Rechnungen' : 'After the date: four calculations'}</h2>
    <ol class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {karten.map((k, i) => (
        <li class="rounded-lg border border-navy-200 bg-white p-4">
          <p class="font-serif text-2xl font-bold text-accent-800">{i + 1}</p>
          {r(k.id) ? <a class="mt-1 block font-semibold text-navy-900 underline" href={r(k.id)}>{k.t}</a> : <p class="mt-1 font-semibold text-navy-900">{k.t}</p>}
          <p class="mt-1 text-sm text-navy-700">{k.d}</p>
        </li>
      ))}
    </ol>
  </section>
  <div class="prose prose-slate mt-10 max-w-none border-t border-navy-200 pt-4">
    {parts.map((p, i) => i % 2 === 0 ? <Fragment set:html={p} /> : <MiniSim client:load kind={p} lang={lang} href={r('rentenbeginn-rechner')} />)}
  </div>
</PageLayout>

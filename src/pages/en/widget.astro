---
import PageLayout from '../../layouts/PageLayout.astro';
import { SITE_URL } from '../../data/site-config';
import { route } from '../../i18n/routes';
import { breadcrumbSchema } from '../../lib/seo';
const lang = 'en';
const code = `<iframe src="${SITE_URL}/embed/rentenfenster/" title="Start date and reduction" width="100%" height="1050" style="border:0;max-width:1100px" loading="lazy"></iframe>`;
const code2 = `<iframe src="${SITE_URL}/embed/nettorente/" title="Gross to net pension" width="100%" height="1000" style="border:0;max-width:1100px" loading="lazy"></iframe>`;
---
<PageLayout title="Embed a German pension calculator free: start date and net" description="Embed the retirement window with the start date and reduction for every birth year, or the 2026 German net pension calculator, free by iframe: copy the code, no cookies." lang={lang} noindex={true} jsonLd={[breadcrumbSchema([{ name: lang === 'de' ? 'Start' : 'Home', path: route('home', lang) }, { name: 'Widget', path: route('widget', lang) }])]} breadcrumbs={[{ label: 'Widget' }]} showAuthor={false}>
  <header class="mb-6">
    <h1 class="text-3xl font-bold text-navy-900 md:text-4xl">Embed a German pension calculator</h1>
    <p class="mt-3 text-lg text-navy-700">For works councils, expat associations, HR teams and relocation services: copy once, the pension value and the law update themselves.</p>
  </header>
  <div class="prose prose-slate max-w-none">
    <h2>Start date and reduction</h2>
    <pre class="overflow-x-auto rounded-lg bg-navy-900 p-4 text-sm text-white"><code>{code}</code></pre>
    <h2>Gross to net pension</h2>
    <pre class="overflow-x-auto rounded-lg bg-navy-900 p-4 text-sm text-white"><code>{code2}</code></pre>
    <p>Terms: the source link under the calculator stays visible, the calculator is not altered and is provided without warranty. Add <code>?lang=en</code> for the English version. What your readers type stays on their device.</p>
    <p>Questions via the <a href={route('contact', lang)}>contact page</a>.</p>
  </div>
  <div class="mt-8 overflow-hidden rounded-xl border border-navy-200">
    <iframe src={`/embed/rentenfenster/${lang === 'en' ? '?lang=en' : ''}`} title="Start date and reduction" width="100%" height="1050" style="border:0" loading="lazy"></iframe>
  </div>
</PageLayout>

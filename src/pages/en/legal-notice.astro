---
import PageLayout from '../../layouts/PageLayout.astro';
import LegalIdentity from '../../components/LegalIdentity.astro';
import { AUTHOR_NAME, CONTACT_EMAIL, LAST_UPDATED, SITE_URL } from '../../data/site-config';
import { route } from '../../i18n/routes';
const lang = 'en';
---
<PageLayout title="Legal notice: publisher of these German pension calculators" description="Legal notice under section 5 DDG and section 18 MStV: who publishes the German pension age, reduction, net pension and survivor calculators, who is responsible, who hosts." lang={lang} noindex={true} breadcrumbs={[{ label: 'Legal notice' }]} showAuthor={false}>
  <div class="prose prose-slate max-w-none">
    <h1>Legal notice</h1>
    <p>Information under section 5 of the German Digital Services Act (DDG) for {SITE_URL}.</p>
    <h2>Publisher</h2>
    <LegalIdentity lang={lang} />
    <h2>Responsible for content (section 18(2) MStV)</h2>
    <p>{AUTHOR_NAME}, address as above, email <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>.</p>
    <h2>Hosting</h2>
    <LegalIdentity mode="hosting" lang={lang} />
    <h2>What the site does</h2>
    <p>The site works out retirement ages, reductions and pension amounts of the German statutory pension under Book VI of the Social Code, and contributions and tax on pensions under SGB V, SGB XI and the Income Tax Act. It is not a service of the Deutsche Rentenversicherung or any authority, not legal pension advice and not tax advice. Only the pension insurer decides on your pension. Methods: <a href={route('method', lang)}>how we calculate</a>.</p>
    <h2>Liability</h2>
    <p>Values are checked after every change in the law and every pension increase and are tested automatically before each release; we cannot guarantee that they are free of errors. Linked third-party sites are the responsibility of their operators. Please report errors via the <a href={route('contact', lang)}>contact page</a>.</p>
    <h2>Embedding</h2>
    <p>The retirement window and the net pension calculator may be embedded free of charge by iframe as long as the source link stays visible: <a href={route('widget', lang)}>embed a calculator</a>.</p>
    <h2>Consumer dispute resolution</h2>
    <p>We are neither willing nor obliged to take part in proceedings before a consumer arbitration board. Privacy: <a href={route('privacy', lang)}>privacy policy</a> and <a href={route('cookies', lang)}>cookies</a>. Version: {LAST_UPDATED}.</p>
  </div>
</PageLayout>
